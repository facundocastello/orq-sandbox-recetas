{
  "name": "orq-sandbox-recetas",
  "version": "0.1.0",
  "private": true,
  "description": "Toy recipe list app used as a throwaway target for orquestador end-to-end tests.",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm api\" \"vite\"",
    "api": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prod:up": "docker compose -f prod/docker-compose.yml up -d --build --wait",
    "prod:down": "docker compose -f prod/docker-compose.yml down -v"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
